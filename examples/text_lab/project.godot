; 文字DOMと標準Canvasの全機能実験場。

config_version=5

[application]

config/name="Text DOM Lab"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[physics]

2d/default_gravity=980.0

[editor_plugins]

enabled=PackedStringArray("res://addons/yurutto_website_exporter/plugin.cfg", "res://addons/yurutto_website_exporter/plugin.cfg", "res://addons/yurutto_website_exporter/plugin.cfg", "res://addons/yurutto_website_exporter/plugin.cfg", "res://addons/yurutto_website_exporter/plugin.cfg")
