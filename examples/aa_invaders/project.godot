; スマートフォン向けAA固定画面シューティングゲーム。

config_version=5

[application]

config/name="Kaomoji AA Invaders"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor_plugins]

enabled=PackedStringArray("res://addons/yurutto_website_exporter/plugin.cfg")
