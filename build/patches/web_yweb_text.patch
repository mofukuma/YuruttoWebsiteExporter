+#ifdef YWEB_TEXT_DOM_ENABLED
+// 保存済みMultiMesh bufferから2Dまたは3D Transformを復元する。
+void MultiMesh::_yweb_store_buffer(const Vector<float> &p_buffer) {
+	if (instance_count == 0) return;
+	uint32_t stride = (transform_format == TRANSFORM_2D ? 8 : 12) + (use_colors ? 4 : 0) + (use_custom_data ? 4 : 0);
+	if (p_buffer.size() != stride * instance_count) return;
+	for (int index = 0; index < instance_count; index++) {
+		const float *data = p_buffer.ptr() + index * stride;
+		if (transform_format == TRANSFORM_2D) {
+			yweb_transforms_2d.write[index] = Transform2D(data[0], data[4], data[1], data[5], data[3], data[7]);
+			continue;
+		}
+		Transform3D transform;
+		transform.basis.rows[0] = Vector3(data[0], data[1], data[2]);
+		transform.basis.rows[1] = Vector3(data[4], data[5], data[6]);
+		transform.basis.rows[2] = Vector3(data[8], data[9], data[10]);
+		transform.origin = Vector3(data[3], data[7], data[11]);
+		yweb_transforms.write[index] = transform;
+	}
+}
+#endif
