+#ifdef YWEB_TEXT_DOM_ENABLED
+// DOM項目のhoverを標準Theme描画とsignalへ反映する。
+void PopupMenu::yweb_hover(int p_index) {
+	if (p_index < 0 || p_index >= items.size() || items[p_index].separator || items[p_index].disabled || !items[p_index].visible) p_index = -1;
+	if (mouse_over == p_index) return;
+	prev_mouse_over = mouse_over;
+	mouse_over = p_index;
+	if (p_index >= 0) emit_signal(SNAME("id_focused"), items[p_index].id);
+	control->queue_redraw();
+}
+
+// DOM項目の選択をsubmenu展開または標準activateへ渡す。
+void PopupMenu::yweb_activate(int p_index) {
+	if (p_index < 0 || p_index >= items.size() || items[p_index].separator || items[p_index].disabled || !items[p_index].visible) return;
+	if (items[p_index].submenu) _activate_submenu(p_index);
+	else activate_item(p_index);
+}
+
+// 描画済み文字の縦位置から、非表示や空区切りを含む実項目番号を返す。
+int PopupMenu::yweb_item_at(float p_y) const {
+	for (int index = 0; index < items.size(); index++) {
+		if (!items[index].visible) continue;
+		if (p_y >= items[index]._ofs_cache && p_y < items[index]._ofs_cache + items[index]._height_cache) return index;
+	}
+	return -1;
+}
+
+// Browser操作域へ使う、項目間余白を含む標準行矩形を返す。
+Rect2 PopupMenu::yweb_item_rect(int p_index) const {
+	ERR_FAIL_INDEX_V(p_index, items.size(), Rect2());
+	const float separation = theme_cache.v_separation;
+	return Rect2(0, items[p_index]._ofs_cache - separation * 0.5f, control->get_size().x, items[p_index]._height_cache + separation);
+}
+#endif
+
