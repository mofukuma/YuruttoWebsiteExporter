+#ifdef YWEB_TEXT_DOM_ENABLED
+// GPU代替のCPU simulationをtree外でもGodot本体と同じ刻みで進める。
+void CPUParticles2D::yweb_advance(double p_delta) {
+	MutexLock lock(update_mutex);
+	if (particles.is_empty()) return;
+	const double step = fixed_fps > 0 ? 1.0 / fixed_fps : 1.0 / 30.0;
+	if (time == 0 && pre_process_time > 0) {
+		double todo = pre_process_time;
+		const float old_scale = speed_scale;
+		speed_scale = 1.0;
+		while (todo > 0) {
+			_particles_process(MIN(todo, step));
+			todo -= step;
+		}
+		speed_scale = old_scale;
+	}
+	if (fixed_fps > 0) {
+		frame_remainder += CLAMP(p_delta, 0.0, 0.1);
+		while (frame_remainder >= step) {
+			_particles_process(step);
+			frame_remainder -= step;
+		}
+	} else {
+		_particles_process(CLAMP(p_delta, 0.0, 0.1));
+	}
+}
+
+// CPU simulationが確定した生存粒子を、一度のlockでRenderingServerと同じlocal Transformへ写す。
+void CPUParticles2D::yweb_particles(Vector<Transform2D> &r_transforms, Vector<Color> &r_colors, int p_limit) {
+	MutexLock lock(update_mutex);
+	r_transforms.clear();
+	r_colors.clear();
+	const int count = MIN(particles.size(), p_limit);
+	for (int index = 0; index < count; index++) {
+		if (!particles[index].active) continue;
+		Transform2D transform = particles[index].transform;
+		if (!local_coords) transform = inv_emission_transform * transform;
+		r_transforms.push_back(transform);
+		r_colors.push_back(particles[index].color);
+	}
+}
+#endif
