+#ifdef YWEB_TEXT_DOM_ENABLED
+// DOMで確定したControlから標準mouse-over階層とsignalを更新する。
+void Viewport::yweb_update_mouse_over(Control *p_over) {
+	const ObjectID over_id = p_over ? p_over->get_instance_id() : ObjectID();
+	if (gui.yweb_mouse_over == over_id) return;
+	if (gui.mouse_over.is_valid() || !gui.mouse_over_hierarchy.is_empty()) _drop_mouse_over();
+	gui.yweb_mouse_over = over_id;
+	if (!p_over) {
+		return;
+	}
+	LocalVector<ObjectID> ancestors;
+	CanvasItem *ancestor = p_over;
+	while (ancestor) {
+		Control *control = Object::cast_to<Control>(ancestor);
+		if (control) {
+			const Control::MouseFilter filter = control->get_mouse_filter_with_override();
+			if (filter != Control::MOUSE_FILTER_IGNORE) ancestors.push_back(control->get_instance_id());
+			if (filter == Control::MOUSE_FILTER_STOP) break;
+		}
+		if (ancestor->is_set_as_top_level()) break;
+		ancestor = ancestor->get_parent_item();
+	}
+	if (ancestors.is_empty()) {
+		gui.yweb_mouse_over = ObjectID();
