# 三段のlevelが共通で使うSCons option。levelごとの差はlevels.optionsが持つ。
platform=web
target=template_release
yweb_text_dom=yes
optimize=size_extra
lto=none
debug_symbols=no
threads=no
vulkan=no
javascript_eval=no
dlink_enabled=no
disable_physics_2d=no
disable_navigation_2d=no
disable_xr=yes
disable_path_overrides=no
modules_enabled_by_default=yes
wasm_simd=no
initial_memory=32
progress=no
