# 秘密情報、環境固有file、再生成できる中間物をGit管理から除外する。

# 秘密情報と署名鍵
.env
.env.*
!.env.example
*.pem
*.p12
*.keystore

# OS生成file
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Editorと開発tool
.idea/
.vscode/
*.swp
*.swo
*~
.claude/settings.local.json
.claude/worktrees/

# Godotが再生成するimport cache
**/.godot/
**/*.import

# 利用者projectへ複製した配布addon
examples/*/addons/yurutto_website_exporter/
sample/*/addons/yurutto_website_exporter/

# Node
node_modules/
.npm/
npm-debug.log*

# Build中間物とtoolchain cache
tmp/
.scons_cache/
.sconsign.dblite
__pycache__/
*.pyc
*.o
*.os
*.obj

# 検査成果物
coverage/
*.log

# 作例から再生成できるWeb成果物
sample/*/output/

# Web fontはbuild/fetch_webfont.cjsで取得し、repositoryへ含めない
*.ttf
*.otf
*.woff
*.woff2
*.eot

# 外部sourceの取得素材など、公開しない個人用の資材と検査
private/
